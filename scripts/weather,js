// weather.js — OpenWeatherMap version
(function () {
  const widget = document.getElementById('weatherWidget');

  // ✔ Your OpenWeatherMap API Key
  const API_KEY = "29d21f6d21332090b676864d7a297325";

  function showMessage(msg) {
    if (widget) widget.textContent = msg;
  }

  async function fetchWeather(lat, lon) {
    try {
      const url =
        `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=${API_KEY}`;

      const res = await fetch(url);
      if (!res.ok) throw new Error("Weather fetch failed");

      const data = await res.json();
      const tempC = Math.round(data.main.temp);
      const desc = data.weather[0].description.replace(/\b\w/g, c => c.toUpperCase());

      // ✔ Shows today's live weather in clean format
      showMessage(`Weather Today: ${tempC}°C • ${desc}`);
    } catch (err) {
      console.error(err);
      showMessage("Unable to load weather");
    }
  }

  function requestLocation() {
    if (!navigator.geolocation) {
      showMessage("Geolocation not supported");
      return;
    }

    showMessage("Detecting location...");

    navigator.geolocation.getCurrentPosition(
      pos => {
        const { latitude, longitude } = pos.coords;
        fetchWeather(latitude, longitude);
      },
      () => showMessage("Location denied — weather unavailable"),
      { timeout: 10000 }
    );
  }

  document.addEventListener("DOMContentLoaded", requestLocation);
})();
